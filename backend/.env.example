# ── Core ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
# Either set DATABASE_URL (e.g. your Railway Postgres) ...
DATABASE_URL=postgres://user:password@host:5432/dbname
# ... or the discrete DB_* vars for a local Postgres:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=lomda_db

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRY=7d
ENCRYPTION_KEY=change-me-32-chars-min

# ── Email (SendGrid) ──────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Lomda App

# ── AI (Anthropic Claude) — in-builder lomda chatbot ──────────────────────
# Required for the "✨ עוזר AI" panel. Without it the panel shows a clean
# "AI not configured" message instead of generating content.
ANTHROPIC_API_KEY=
# Optional: override the model (default is a cheap Haiku). For better drafts:
# AI_MODEL=claude-sonnet-4-6
# AI_MAX_TOKENS=4096

# ── Microsoft Entra ID (Azure AD) directory sync ──────────────────────────
# DEV: set ENTRA_MOCK=true to import sample employees WITHOUT calling Microsoft.
# Remove it (or set anything but 'true') once the real values below are filled.
ENTRA_MOCK=true
# Real tenant values (from your Entra App registration). With these set and
# ENTRA_MOCK removed, sync pulls your actual directory via Microsoft Graph:
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
