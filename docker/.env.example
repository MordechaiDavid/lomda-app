# Environment Configuration for Lomda App
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=lomda_user
DB_PASSWORD=change_me_in_production
DB_NAME=lomda_db
DATABASE_URL=postgresql://lomda_user:change_me_in_production@postgres:5432/lomda_db

# Redis
REDIS_URL=redis://redis:6379

# JWT & Tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d
MAGIC_LINK_EXPIRY=15m
MAGIC_LINK_SECRET=your_magic_link_secret_key

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@lomda-app.com
SENDGRID_FROM_NAME=Lomda App

# AWS SES (Alternative to SendGrid)
AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Service Selection (sendgrid or aws_ses)
EMAIL_PROVIDER=sendgrid

# Server
PORT=3001
API_PORT=3001
LOG_LEVEL=info

# Security
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data
CORS_ORIGIN=http://localhost:3000

# Data Retention (days)
MAGIC_TOKEN_EXPIRY_DAYS=1
ANALYTICS_RETENTION_DAYS=90

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_EXPORT=true
ENABLE_AUTO_REMINDERS=true

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Frontend Build
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Lomda
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
